{
  "name": "compas",
  "version": "0.1.0",
  "private": true,
  "description": "Comp\u00e1s \u2014 open, free musical companion for salsa & bachata dancers",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:web": "pnpm --filter @compas/web dev",
    "dev:api": "pnpm --filter @compas/api dev",
    "dev:worker": "pnpm --filter @compas/worker dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "clean": "pnpm -r exec rm -rf node_modules dist .svelte-kit build && rm -rf node_modules"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}